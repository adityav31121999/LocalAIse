# Dependencies
/node_modules/
/resources/

# Build output
/dist/
/build/
/coverage/
/.vite/
/.cache/
/src-tauri/target/
/src-tauri/gen/
/vendor/llama.cpp/build*/

# Generated llama.cpp runtimes (recreate with npm run fetch-llama-server)
# Flat platform dirs (windows-x64, linux-x64) and any legacy per-backend dirs.
/resources/llama/*/*.dll
/resources/llama/*/*.exe
/resources/llama/*/*.so
/resources/llama/*/*.so.*
/resources/llama/*/*.dylib
/resources/llama/*/*.a
/resources/llama/*/*.lib
/resources/llama/*/llama-server
/resources/llama/*/build-info*.json

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# Local databases and model files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.gguf
*.gguf.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/
.vs/
.fleet/
.history/
*.code-workspace

# Rust build artifacts
**/target/
**/*.rs.bk
*.o
*.obj
*.pdb
*.ilk
*.class

# Python tooling
__pycache__/
*.py[cod]
.venv/
venv/

# Test and analysis output
playwright-report/
test-results/
*.lcov
gcovr-report/
