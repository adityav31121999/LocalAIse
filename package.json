{
  "name": "LocalAIse",
  "private": true,
  "version": "0.1",
  "type": "module",
  "description": "Private, local-first AI workspace for folders you own.",
  "scripts": {
    "dev": "vite",
    "start": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-llama-server": "npx tsx scripts/fetch-llama-server.ts",
    "fetch-llama-server:win": "npx tsx scripts/fetch-llama-server.ts windows-x64 cpu",
    "fetch-llama-server:linux": "npx tsx scripts/fetch-llama-server.ts linux-x64 cpu",
    "verify-binaries": "npx tsx scripts/verify-binaries.ts",
    "check-bundle": "npx tsx scripts/check-bundle.ts",
    "tauri": "tauri",
    "lint": "tsc --noEmit",
    "build:windows": "npm run fetch-llama-server:win && npm run build && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:linux": "npm run fetch-llama-server:linux && npm run build && tauri build --target x86_64-unknown-linux-gnu --bundles appimage,deb"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
